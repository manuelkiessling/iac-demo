{
  "name": "iac-demo",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": ">=12.2.1 <13"
  },
  "scripts": {
    "dev": "npm run build && node dist/server/local.js",
    "build": "node scripts/clean.mjs && ng build && tsc -p tsconfig.server.json",
    "test": "npm run build && node --test dist/server/*.test.js",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1156.0",
    "@aws-sdk/lib-dynamodb": "3.1156.0",
    "@codegenie/serverless-express": "5.0.0",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@angular/build": "22.2.4",
    "@angular/cli": "22.2.4",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@types/aws-lambda": "8.10.164",
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  },
  "type": "module",
  "packageManager": "npm@12.2.1",
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@parcel/watcher@2.6.0": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
