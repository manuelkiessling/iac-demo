variable "aws_region" {
  description = "AWS region for this demo."
  type        = string
  default     = "eu-central-1"
}
variable "name" {
  description = "Unique resource prefix within the AWS account and region."
  type        = string
  default     = "iac-demo"
  validation {
    condition     = can(regex("^[a-z][a-z0-9-]{2,39}$", var.name))
    error_message = "Use 3–40 lowercase letters, digits or hyphens, starting with a letter."
  }
}

variable "project_account_id" {
  description = "Member account ID generated by project bootstrap."
  type        = string
  validation {
    condition     = can(regex("^[0-9]{12}$", var.project_account_id)) && var.project_account_id != jsondecode(file("${path.module}/bootstrap/settings.json")).management_account_id
    error_message = "Use the bootstrapped project account ID; application deployment in the management account is blocked."
  }
}
